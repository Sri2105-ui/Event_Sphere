# EventSphere Frontend Environment Variables
# In production (e.g. on Vercel), set this to your Render backend URL:
# Example: https://eventsphere-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Optional: if WebSocket server is hosted separately (defaults to VITE_API_URL base)
# VITE_SOCKET_URL=https://eventsphere-api.onrender.com
